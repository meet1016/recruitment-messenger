# APP_URL: The URL where this application is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: HMAC signing secret for download URLs and session tokens (optional; falls back to runtime random secret).
SESSION_SECRET=""

# ADMIN_PASSCODE: Optional server-side override password for the primary Team Lead account.
ADMIN_PASSCODE=""

# ENABLE_SANDBOX_LOGIN: Set to "false" in production to disable one-click sandbox persona switching.
ENABLE_SANDBOX_LOGIN="true"

# DATABASE_PATH: SQLite database file path (SQLite / Cloudflare D1 compatible SQL dialect).
DATABASE_PATH="./data/recruitment_messenger.db"

# Cloudflare R2 Private Object Storage (Optional; falls back to confined ./private_storage directory in local mode)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# LiveKit Managed WebRTC Calling Infrastructure (Optional; defaults to built-in P2P WebRTC over WebSockets)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# SMTP Email Notifications (Optional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@recruitmentmessenger.app"
